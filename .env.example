# ==============================================================================
# broski — Environment Configuration Template
# Copy this file to .env and customize with your own settings and API keys.
# DO NOT commit your real .env file with secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud AI & Reasoning (Google Gemini)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# 2. Audio Sensory Pipeline (Local Real-Time)
# ------------------------------------------------------------------------------
# 16000 Hz 16-bit mono PCM is the standard format for openWakeWord, Silero, and Whisper
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_INPUT_DEVICE_INDEX=
AUDIO_OUTPUT_DEVICE_INDEX=

# Wake Word
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5

# Voice Activity Detection (VAD)
VAD_THRESHOLD=0.5
VAD_SILENCE_DURATION_MS=600

# Whisper Speech-to-Text (Local INT8 CPU)
WHISPER_MODEL_SIZE=base.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2

# Piper Neural Text-to-Speech
PIPER_VOICE_NAME=en_US-lessac-medium

# ------------------------------------------------------------------------------
# 3. Third-Party Integrations
# ------------------------------------------------------------------------------
# Obsidian Local REST API plugin (community plugin for Obsidian)
OBSIDIAN_API_KEY=
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27124
OBSIDIAN_USE_HTTPS=true

# ------------------------------------------------------------------------------
# 4. Paths, Storage & Security Gating
# ------------------------------------------------------------------------------
# Storage root for local SQLite db, cache, and downloaded models
DATA_DIR=data
DB_NAME=broski.db

# Security confirmation gating
REQUIRE_CONFIRMATION_FOR_CRITICAL=true
CONFIRMATION_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
